# ===================================================
# MicroCFO — Environment Variables Configuration
# ===================================================

# 1. Google Gemini API (Free tier from https://aistudio.google.com/app/apikey)
# Powers the AI side-hustle risk auditor, unit economics critique, and receipt scanner.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Model identifier (Default is official high-speed flash model)
GEMINI_MODEL=gemini-3.8-flash-lite

# 3. Supabase (Free PostgreSQL + Auth + Storage from https://supabase.com)
# Optional for local test (falls back to local persistence), but essential for multi-device sync
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. Base App URL (Update on Vercel deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
